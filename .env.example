# Copy to .env (never commit it). All app settings are PUNCTUAL_* (see src/punctual/settings.py).

# --- Docker Compose only ---
PUNCTUAL_DOMAIN=punctual.example.com   # DNS must point to this host; Caddy gets the certificate

# --- Required on first start (creates the first admin when the DB is empty) ---
PUNCTUAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PUNCTUAL_BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars   # remove this line after the first login
PUNCTUAL_PUBLIC_URL=https://punctual.example.com            # base URL encoded in QR codes
PUNCTUAL_TIMEZONE=UTC                                       # e.g. Europe/Bucharest
PUNCTUAL_LOCALE=en                                          # interface language: en or ro

# --- Local development only (plain http) ---
# PUNCTUAL_COOKIE_SECURE=false

# --- Backup (optional but strongly recommended): a Litestream replica URL ---
# Google Cloud Storage. On Cloud Run nothing else is needed: the service account authenticates (deploy.sh sets this up).
# LITESTREAM_REPLICA_URL=gs://my-bucket/db-v5
# On a VPS with Docker Compose, give Litestream a service-account key file (mount it in docker-compose.yml):
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
#
# S3, MinIO, Backblaze B2: these two variables are for S3-compatible storage only (not GCS).
# LITESTREAM_REPLICA_URL=s3://my-bucket/punctual
# LITESTREAM_ACCESS_KEY_ID=...
# LITESTREAM_SECRET_ACCESS_KEY=...
#
# Local drill, no cloud (mount a volume at /replica):
# LITESTREAM_REPLICA_URL=file:///replica
#
# Never set a production replica URL in a development .env: dev would replicate into production's backup.
