# Copy to .env (never commit it). All app settings are PUNCTUAL_* (see src/punctual/settings.py).

# --- Docker Compose only ---
PUNCTUAL_DOMAIN=punctual.example.com   # DNS must point to this host; Caddy gets the certificate

# --- Required on first start (creates the first admin when the DB is empty) ---
PUNCTUAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PUNCTUAL_BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars   # remove this line after the first login
PUNCTUAL_PUBLIC_URL=https://punctual.example.com            # base URL encoded in QR codes
PUNCTUAL_TIMEZONE=UTC                                       # e.g. Europe/Bucharest
PUNCTUAL_LOCALE=en                                          # interface language: en or ro

# --- Local development only (plain http) ---
# PUNCTUAL_COOKIE_SECURE=false

# --- Backup (optional but strongly recommended): any Litestream replica URL ---
# LITESTREAM_REPLICA_URL=s3://my-bucket/punctual
# LITESTREAM_ACCESS_KEY_ID=...
# LITESTREAM_SECRET_ACCESS_KEY=...
# LITESTREAM_REPLICA_URL=file:///replica      # local drill; mount a volume at /replica
